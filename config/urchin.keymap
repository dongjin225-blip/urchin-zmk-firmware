#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors/battery_percentage_printer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Layer definitions

#define BASE 0
#define NAV 1
#define MOUSE 2
#define EMACS 3
#define SYM 4
#define NUMB 5
#define FUNC 6

// -----------------

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 31 30>;
        };

        alt_tab_override: alt_tab_override {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TAB_OVERRIDE";
            bindings = <&kp FSLH>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_DANCE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <165>;
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };

        alt_tab_override2: alt_tab_override2 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TAB_OVERRIDE2";
            bindings = <&kp DOT>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_TAP";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <165>;
            quick-tap-ms = <165>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };

        emacs_up: emacs_up {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_UP";
            bindings = <&kp UP_ARROW>, <&kp LA(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_down: emacs_down {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_DOWN";
            bindings = <&kp DOWN_ARROW>, <&kp LC(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_left: emacs_left {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_LEFT";
            bindings = <&kp LEFT_ARROW>, <&kp RA(B)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_right: emacs_right {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_RIGHT";
            bindings = <&kp RIGHT_ARROW>, <&kp RA(F)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic: magic {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>;

            akt_ah {
                trigger-keys = <A>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp O>;
            };

            akt_ch {
                trigger-keys = <C>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_dh {
                trigger-keys = <D>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_eh {
                trigger-keys = <E>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp U>;
            };

            akt_gh {
                trigger-keys = <G>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_di {
                trigger-keys = <I>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp O &kp N>;
            };

            akt_dl {
                trigger-keys = <L>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp K>;
            };

            akt_dm {
                trigger-keys = <M>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp E &kp N &kp T>;
            };

            akt_dn {
                trigger-keys = <N>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp I &kp O &kp N>;
            };

            akt_do {
                trigger-keys = <O>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp A>;
            };

            akt_dp {
                trigger-keys = <P>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_dq {
                trigger-keys = <Q>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp U &kp E &kp N>;
            };

            akt_rh {
                trigger-keys = <R>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp L>;
            };

            akt_ds {
                trigger-keys = <S>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp K>;
            };

            akt_dt {
                trigger-keys = <T>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp M &kp E &kp N &kp T>;
            };

            akt_du {
                trigger-keys = <U>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp E>;
            };

            akt_dy {
                trigger-keys = <Y>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp P>;
            };

            akt_dsp {
                trigger-keys = <SPACE>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp T &kp H &kp E>;
            };

            akt_ddot {
                trigger-keys = <DOT>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp DOT &kp SLASH>;
            };
        };

        hm_combo: hm_combo {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_COMBO";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33 4 14 24 30 10 20 21 22 23 24 30 31 0 1 2 3 11 12 13>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        dj: dj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp O &kp P &kp ASTERISK &kp NUMBER_6 &kp NUMBER_4 &kp NUMBER_3 &kp N5 &kp NUMBER_1 &kp N8 &kp ENTER>;
            label = "DJ";
        };

        dj2: dj2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_3 &kp N5 &kp NUMBER_1 &kp N8>;
            label = "DJ2";
        };

        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "SLEEP";
            wait-ms = <1000>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        esc {
            bindings = <&hm_combo DEL ESCAPE>;
            key-positions = <0 1>;
        };

        ex {
            bindings = <&kp EXCLAMATION>;
            key-positions = <15 16>;
        };

        slash_quet {
            bindings = <&kp LS(SLASH)>;
            key-positions = <16 25>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <3 12>;
        };

        plus {
            bindings = <&kp EQUAL>;
            key-positions = <3 2>;
        };

        space_l {
            bindings = <&kp SPACE>;
            key-positions = <12 13>;
        };

        enter_l {
            bindings = <&kp ENTER>;
            key-positions = <11 12>;
        };

        enter_r {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
        };

        brace_r {
            bindings = <&hm_combo RIGHT_BRACKET RIGHT_PARENTHESIS>;
            key-positions = <17 8>;
        };

        brace_l {
            bindings = <&hm_combo LEFT_BRACKET LEFT_PARENTHESIS>;
            key-positions = <1 12>;
        };

        tap {
            bindings = <&kp TAB>;
            key-positions = <2 13>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <2 11>;
        };

        del_l {
            bindings = <&kp DEL>;
            key-positions = <24 13>;
        };

        del_r {
            bindings = <&kp DEL>;
            key-positions = <16 25>;
        };

        capture {
            bindings = <&kp LG(LS(S))>;
            key-positions = <4 3>;
        };

        vup {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <27 28>;
        };

        vdn {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <27 26>;
        };

        mute {
            bindings = <&kp K_MUTE>;
            key-positions = <26 28>;
        };

        wintab {
            bindings = <&kp LG(TAB)>;
            key-positions = <2 13 24>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 11>;
        };

        num1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <24 0>;
        };

        num2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <24 1>;
        };

        num3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <24 2>;
        };

        num4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <24 3>;
        };

        num5 {
            bindings = <&kp N5>;
            key-positions = <24 4>;
        };

        num6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <30 10>;
        };

        num7 {
            bindings = <&kp N7>;
            key-positions = <30 11>;
        };

        num8 {
            bindings = <&kp N8>;
            key-positions = <30 12>;
        };

        num9 {
            bindings = <&kp N9>;
            key-positions = <30 13>;
        };

        num0 {
            bindings = <&kp N0>;
            key-positions = <30 14>;
        };

        workman {
            bindings = <&kp LS(LC(ESC))>;
            key-positions = <24 1 0>;
        };

        altfb4 {
            bindings = <&kp LA(F4)>;
            key-positions = <24 3 2>;
        };

        wind {
            bindings = <&kp LG(D)>;
            key-positions = <24 3 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
&hml LS(LC(N)) Q  &hml F2 W     &hml LG(E) E  &hml RIGHT_ALT R   &hml LEFT_ALT T  &kp Y     &kp U               &kp I         &kp O             &kp P
&lt 1 A           &hml LC(S) S  &hml LC(D) D  &hml LEFT_SHIFT F  &lt 2 G          &kp H     &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr SQT SEMI
&hml LC(Z) Z      &hml LC(X) X  &hml LC(C) C  &hml LC(V) V       &hml LCTRL B     &hmr B N  &hmr LC(M) M        &kp COMMA     &kp DOT           &kp FSLH
                                              &to 1              &kp SPACE        &kp BSPC  &mo 1
            >;
        };

        // Numbers and high frequency symbols
        // Mouse
        // Emacs navigation aid
        // Symbols
        // Numbers
        // Function layer

        num {
            bindings = <
&dj2         &kp F7  &kp F8  &kp F9  &trans  &trans          &hmr LS(N7) N7              &hmr LS(N8) N8              &hmr LS(N9) N9        &trans
&dj          &kp F4  &kp F5  &kp F6  &trans  &trans          &hmr LS(N4) NUMBER_4        &hmr LS(N5) N5              &hmr LS(N6) NUMBER_6  &trans
&bootloader  &kp F1  &kp F2  &kp F3  &trans  &hmr LS(N0) N0  &hmr LS(NUMBER_1) NUMBER_1  &hmr LS(NUMBER_2) NUMBER_2  &hml LS(N3) NUMBER_3  &bootloader
                             &trans  &trans  &trans          &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp UP_ARROW  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
                        &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
