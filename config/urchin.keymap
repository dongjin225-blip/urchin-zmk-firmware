#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors/battery_percentage_printer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Layer definitions

#define BASE 0
#define NAV 1
#define MOUSE 2
#define EMACS 3
#define SYM 4
#define NUMB 5
#define FUNC 6

// -----------------

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 31 30>;
        };

        alt_tab_override: alt_tab_override {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TAB_OVERRIDE";
            bindings = <&kp FSLH>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_DANCE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <165>;
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };

        alt_tab_override2: alt_tab_override2 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TAB_OVERRIDE2";
            bindings = <&kp DOT>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_TAP";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <165>;
            quick-tap-ms = <165>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };

        emacs_up: emacs_up {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_UP";
            bindings = <&kp UP_ARROW>, <&kp LA(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_down: emacs_down {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_DOWN";
            bindings = <&kp DOWN_ARROW>, <&kp LC(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_left: emacs_left {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_LEFT";
            bindings = <&kp LEFT_ARROW>, <&kp RA(B)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        emacs_right: emacs_right {
            compatible = "zmk,behavior-mod-morph";
            label = "EMACS_RIGHT";
            bindings = <&kp RIGHT_ARROW>, <&kp RA(F)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic: magic {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>;

            akt_ah {
                trigger-keys = <A>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp O>;
            };

            akt_ch {
                trigger-keys = <C>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_dh {
                trigger-keys = <D>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_eh {
                trigger-keys = <E>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp U>;
            };

            akt_gh {
                trigger-keys = <G>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_di {
                trigger-keys = <I>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp O &kp N>;
            };

            akt_dl {
                trigger-keys = <L>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp K>;
            };

            akt_dm {
                trigger-keys = <M>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp E &kp N &kp T>;
            };

            akt_dn {
                trigger-keys = <N>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp I &kp O &kp N>;
            };

            akt_do {
                trigger-keys = <O>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp A>;
            };

            akt_dp {
                trigger-keys = <P>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp Y>;
            };

            akt_dq {
                trigger-keys = <Q>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp U &kp E &kp N>;
            };

            akt_rh {
                trigger-keys = <R>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp L>;
            };

            akt_ds {
                trigger-keys = <S>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp K>;
            };

            akt_dt {
                trigger-keys = <T>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp M &kp E &kp N &kp T>;
            };

            akt_du {
                trigger-keys = <U>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp E>;
            };

            akt_dy {
                trigger-keys = <Y>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp P>;
            };

            akt_dsp {
                trigger-keys = <SPACE>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp T &kp H &kp E>;
            };

            akt_ddot {
                trigger-keys = <DOT>;
                max-prior-idle-ms = <1000>;
                bindings = <&kp DOT &kp SLASH>;
            };
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };

        other_window: other_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X) &kp O>;
            label = "OTHER_WINDOW";
        };

        kill_buffer: kill_buffer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X) &kp K>;
            label = "KILL_BUFFER";
        };

        save_buffer: save_buffer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X) &kp LC(S)>;
            label = "SAVE_BUFFER";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        combo_caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <26 27>;
            layers = <0>;
            timeout-ms = <50>;
            require-prior-idle-ms = <1>;
        };

        alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <9 29>;
        };

        to_emacs {
            bindings = <&tog 0>;
            key-positions = <23 30>;
            layers = <0>;
            timeout-ms = <50>;
            require-prior-idle-ms = <1>;
        };

        to_func {
            bindings = <&tog 0>;
            key-positions = <31 32>;
            layers = <0>;
            timeout-ms = <50>;
            require-prior-idle-ms = <1>;
        };

        momentary_functional_layer {
            bindings = <&mo 0>;
            key-positions = <32 33>;
        };

        Momentary_Emacs_layer {
            bindings = <&mo 0>;
            key-positions = <31 30>;
        };

        to_num {
            bindings = <&to 0>;
            key-positions = <6 33>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <29 0 1>;
        };

        alt-x {
            bindings = <&kp RA(X)>;
            key-positions = <32 21>;
        };

        control-x {
            bindings = <&kp RC(X)>;
            key-positions = <33 21>;
        };

        bootloader2 {
            bindings = <&bootloader>;
            key-positions = <5 6 29>;
        };

        soft_off_combo {
            bindings = <&soft_off>;
            key-positions = <14 15 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
&hml LS(LC(N)) Q  &hml F2 W     &hml LG(E) E  &hml RIGHT_ALT R   &hml LEFT_ALT T  &kp Y     &kp U               &kp I         &kp O             &kp P
&lt 1 A           &hml LC(S) S  &hml LC(D) D  &hml LEFT_SHIFT F  &lt 2 G          &kp H     &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr SQT SEMI
&hml LC(Z) Z      &hml LC(X) X  &hml LC(C) C  &hml LC(V) V       &hml LCTRL B     &hmr B N  &hmr LC(M) M        &kp COMMA     &kp DOT           &kp FSLH
                                              &to 1              &kp SPACE        &kp BSPC  &mo 1
            >;
        };

        // Numbers and high frequency symbols
        // Mouse
        // Emacs navigation aid
        // Symbols
        // Numbers
        // Function layer

        num {
            bindings = <
&trans       &kp F7  &kp F8  &kp F9  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
&trans       &kp F4  &kp F5  &kp F6  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&bootloader  &kp F1  &kp F2  &kp F3  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &bootloader
                             &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp UP_ARROW  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans     &trans
                        &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
